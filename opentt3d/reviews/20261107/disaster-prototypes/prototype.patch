+static bool ConDebugDisaster(std::span<std::string_view> argv)
+{
+	if (argv.size() < 4 || argv.size() > 5) {
+		IConsolePrint(CC_HELP, "Spawn an isolated disaster fixture. Usage: 'debug_disaster <subtype> <x> <y> [direction]'.");
+		return false;
+	}
+	auto subtype = ParseType<uint>(argv[1]);
+	auto x = ParseType<int>(argv[2]);
+	auto y = ParseType<int>(argv[3]);
+	auto direction = argv.size() == 5 ? ParseType<uint>(argv[4]) : std::optional<uint>(4);
+	if (!subtype || *subtype >= 15 || !x || !y || !direction || *direction >= 8) {
+		IConsolePrint(CC_ERROR, "Invalid disaster fixture subtype/position/direction.");
+		return false;
+	}
+	SpawnDisasterForReview(static_cast<DisasterSubType>(*subtype), *x, *y, static_cast<Direction>(*direction));
+	IConsolePrint(CC_DEFAULT, "Spawned disaster fixture subtype {}.", *subtype);
+	return true;
+}
